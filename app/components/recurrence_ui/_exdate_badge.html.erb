<%# Логика для шаблона или реальной даты %>
<% 
  value = local_assigns[:template] ? "VALUE" : date.to_s
  label = local_assigns[:template] ? "LABEL" : l(date, format: :long)
%>

<div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-50 text-red-700 border border-red-100 group" 
     data-exdate-value="<%= value %>">
  <span class="text-sm font-medium"><%= label %></span>
  <button type="button" 
          data-action="click-><%= identifier %>#removeExdate" 
          class="text-red-400 hover:text-red-600 transition-colors">
    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
      <path d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"/>
    </svg>
  </button>
</div>