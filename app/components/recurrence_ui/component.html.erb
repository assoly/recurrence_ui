<%# app/components/recurrence_ui/component.html.erb %>
<%#
  Компонент для управления повторяющимися событиями (Recurrence UI)
  Использует Stimulus для динамического управления полями формы.
  Передаваемые параметры:
  - form: объект формы (form_with)
  - rules: хэш с текущими правилами повторения (IceCube)
  - identifier: уникальный идентификатор для Stimulus контроллера
%>
<div data-controller="<%= identifier %>" 
     data-<%= identifier %>-time-zone-value="<%= Time.zone&.name || 'UTC' %>"
     data-<%= identifier %>-translations-value="<%= t('recurrence_ui').to_json %>"
     data-<%= identifier %>-locale-value="<%= I18n.locale %>"
     data-<%= identifier %>-selected-class="bg-blue-600 text-white border-blue-600"
     class="space-y-4 p-4 bg-white border border-gray-200 rounded-xl shadow-sm">  
  <%# 1. Ссылка-саммари с прерывистой линией %>
  <%= render "recurrence_ui/summary_link", form: form, identifier: identifier %>

  <%# 2. Селект типа повторения (Recurrence Rule Type)%>
  <div data-<%= identifier %>-target="editMode" class="hidden space-y-6">    
    <div>
      <%= form.label :rule_type, t('recurrence_ui.labels.frequency'), class: "block text-sm font-medium" %>
      <%= form.select :rule_type, 
          rule_options, # Метод в компоненте, возвращающий массив для select
          {}, 
          data: { 
            action: "change->#{identifier}#toggleFields", 
            "#{identifier}-target": "ruleType" 
          },
          class: "mt-1 block w-full rounded-md border-gray-300" 
      %>
    </div>

    <%# 3. Плоские блоки полей (Specific Fields) %>
    <%# Каждый блок управляется Stimulus через [data-rule] %>
      <% %w[daily weekly monthly_by_day_of_month monthly_by_weekday yearly_by_day_of_month yearly_by_weekday].each do |rule| %>
      <div data-<%= identifier %>-target="specificFields" data-rule="<%= rule %>" class="hidden">
        <%= render "recurrence_ui/#{rule}", form: form, identifier: identifier, days_for_ui: days_for_ui, rec_ui: self %>
      </div>
    <% end %>

    <%# 4. Секция "Окончание" (Всегда видна, если не выбрано 'never') %>
    <div data-<%= identifier %>-target="terminationBlock" class="pt-4 border-t border-gray-100 hidden">
      <%= render "recurrence_ui/termination", form: form, identifier: identifier %>
    </div>

    <%# 5. Секция "Исключения" %>
    <div data-<%= identifier %>-target="exceptionsBlock" class="pt-4 border-t border-gray-100 hidden">
      <%= render "recurrence_ui/exceptions", form: form, identifier: identifier, exdates: rules[:exdates] || [] %>
    </div>

    <%= render "recurrence_ui/footer_actions", form: form, identifier: identifier %>
  </div>
  <%# 5. СКРЫТОЕ ПОЛЕ: Для сохранения финального хэша IceCube (должно быть обновлено из видимого поля) %>
  <%= form.hidden_field @field_name, 
      value: rules_json, 
      data: { "#{identifier}_target": "hiddenField" } 
  %>
  <%# Временная проверка для Tailwind %>
<div class="hidden bg-blue-600 text-white border-blue-600">TEST</div>
</div>