<%# app/components/recurrence_ui/picker_component.html.erb %>
<% I18n.with_locale(locale) do %>
  <div class="hidden bg-blue-600 text-white border-blue-600"></div>
  <div data-controller="<%= identifier %>" 
       data-<%= identifier %>-time-zone-value="<%= time_zone %>"
       data-<%= identifier %>-translations-value="<%= t('recurrence_ui', locale: locale).to_json %>"
       data-<%= identifier %>-locale-value="<%= locale %>"
       data-<%= identifier %>-selected-class="bg-blue-600 text-white border-blue-600"
       class="space-y-4 p-4 bg-white border border-gray-200 rounded-xl shadow-sm">  

    <%# 1. Summary Link (Уровень U1 - Свернутый вид) %>
    <%= render "recurrence_ui/summary_link", form: form, identifier: identifier, rec_ui: self %>

    <%# 2. Edit Mode Container (Уровень U2 - Раскрытый режим) %>
    <div data-<%= identifier %>-target="editMode" class="hidden space-y-6">  
      
      <%# Шапка режима редактирования с переключателем в Код %>
      <div class="flex items-center justify-between pb-2 border-b border-gray-100">
        <span class="text-sm font-semibold text-gray-700">
          <%= t('recurrence_ui.labels.editor_title', default: 'Настройка повторения') %>
        </span>
        <%# Иконка переключения в режим Кода %>
        <button type="button" 
                data-action="click-><%= identifier %>#toggleCodeEditor" 
                title="<%= t('recurrence_ui.actions.code_mode', default: 'Редактировать код') %>"
                class="p-1.5 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors font-mono text-xs font-bold border border-gray-200">
          &lt;/&gt;
        </button>
      </div>

      <%# А. Визуальный редактор правил %>
      <div data-<%= identifier %>-target="visualEditor" class="space-y-6">
        
        <%# Секция правил повторения %>
        <div class="space-y-3">
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">
            <%= t('recurrence_ui.labels.rules', default: 'Правила повторения') %>
          </label>

          <%# Контейнер для динамических карточек-аккордеонов правил %>
          <div data-<%= identifier %>-target="rulesContainer" class="space-y-3"></div>

          <%# Кнопка добавления нового правила %>
          <button type="button" 
                  data-action="click-><%= identifier %>#addRule" 
                  class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800">
            + <%= t('recurrence_ui.actions.add_rule', default: 'Добавить правило') %>
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-4 border-t border-gray-100">
                <%# Секция Исключений (Теги/Badge) %>
                <div data-<%= identifier %>-target="exceptionsBlock" class="pt-4 border-t border-gray-100 hidden">
                  <%= render "recurrence_ui/exceptions", form: form, identifier: identifier, rec_ui: self, exdates: rules[:exdates] || [] %>
                </div>  
              <%# Секция Дополнительных дат (Теги/Badge) %>
                <div data-<%= identifier %>-target="rdatesBlock" class="pt-4 border-t border-gray-100 hidden">
                  <%= render "recurrence_ui/rdates", form: form, identifier: identifier, rec_ui: self, rdates: rules[:rdates] || [] %>
                </div>
        </div>


        

        

        <%# Нижняя панель действий (Сохранить/ОК) %>
        <%= render "recurrence_ui/footer_actions", form: form, identifier: identifier, rec_ui: self %>
      </div>

      <%# Б. Изолированная панель редактирования Кода (Скрыта по умолчанию) %>
      <div data-<%= identifier %>-target="codeEditor" class="hidden space-y-4">
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">
            <%= t('recurrence_ui.labels.raw_json', default: 'Конфигурация (JSON)') %>
          </label>
          <textarea data-<%= identifier %>-target="iceCubeField" 
                    rows="8" 
                    class="block w-full font-mono text-xs p-3 rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 bg-gray-900 text-green-400"></textarea>
        </div>
        <div class="flex items-center justify-end space-x-2">
          <button type="button" 
                  data-action="click-><%= identifier %>#toggleCodeEditor" 
                  class="px-3 py-1.5 text-xs font-medium text-gray-600 hover:text-gray-800 bg-gray-100 hover:bg-gray-200 rounded-md">
            <%= t('recurrence_ui.actions.cancel', default: 'Отмена') %>
          </button>
          <button type="button" 
                  data-action="click-><%= identifier %>#applyCodeChanges" 
                  class="px-3 py-1.5 text-xs font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-md shadow-sm">
            <%= t('recurrence_ui.actions.apply_code', default: 'Применить код') %>
          </button>
        </div>
      </div>

    </div>

    <%# Шаблон карточки правила для динамической спавн-генерации через JS %>
    <template data-<%= identifier %>-target="ruleCardTemplate">
      <%= render "recurrence_ui/rule_card", 
                 form: form, 
                 identifier: identifier, 
                 days_for_ui: days_for_ui, 
                 rec_ui: self, 
                 rule_options: rule_options %>
    </template>

    <%# Настоящее скрытое поле формы Rails %>
    <%= form.hidden_field field_name, value: rules_json, data: { "#{identifier}_target": "hiddenField" } %>
  </div>
<% end %>