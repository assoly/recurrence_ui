<%# app/components/recurrence_ui/picker_component.html.erb %>
<% I18n.with_locale(locale) do %>
  <div data-controller="<%= identifier %>" 
       data-<%= identifier %>-time-zone-value="<%= time_zone %>"
       data-<%= identifier %>-translations-value="<%= t('recurrence_ui', locale: locale).to_json %>"
       data-<%= identifier %>-locale-value="<%= locale %>"
       class="rui-container"
       data-rui-theme="<%= RecurrenceUi.configuration.theme_mode %>">  

    <%# 1. Секция полей времени, окончания и часового пояса (рендерится прямо внутри гема) %>
    <div class="space-y-4 pb-4 border-b border-[var(--rui-border-color)]">
      
      <%# Время начала и окончания %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= form.label start_time_field, t('recurrence_ui.labels.start_at'), class: "rui-label" %>
          <%= form.datetime_field start_time_field, class: "rui-input w-full" %>
        </div>

        <div>
          <%= form.label end_time_field, t('recurrence_ui.labels.end_at'), class: "rui-label" %>
          <%= form.datetime_field end_time_field, class: "rui-input w-full" %>
        </div>
         <div>
          <%= form.label duration_field, t('recurrence_ui.labels.duration'), class: "rui-label" %>
          <%= form.number_field duration_field, class: "rui-input w-full" %>
        </div>
      </div>

      <%# Выбор часового пояса %>
      <div>
        <%= form.label time_zone_field, t('recurrence_ui.labels.time_zone'), class: "rui-label" %>
        <%= form.time_zone_select time_zone_field, 
              ActiveSupport::TimeZone.us_zones, 
              { default: time_zone }, 
              { class: "rui-select w-full cursor-pointer" } %>
      </div>
    </div>

    <%# 2. Summary Link Header (Сводка правила) %>
    <div class="pt-2">
      <%= render "recurrence_ui/summary_link", form: form, identifier: identifier, rec_ui: self %>
    </div>

    <%# 3. Main Edit Mode Panel %>
    <div data-<%= identifier %>-target="editMode" class="hidden space-y-3 pt-2">  
      
      <%# Header bar with Code Editor toggle %>
      <div class="rui-panel-header flex items-center justify-between">
        <span class="rui-header-title">
          <%= t('recurrence_ui.labels.editor_title', default: 'Recurrence') %>
        </span>
        <button type="button" 
                data-action="click-><%= identifier %>#toggleCodeEditor" 
                title="<%= t('recurrence_ui.actions.code_mode', default: 'Code Mode') %>"
                class="rui-btn-secondary font-mono text-xs px-2 py-1">
          &lt;/&gt;
        </button>
      </div>

      <%# A. Visual Rule Editor Section %>
      <div data-<%= identifier %>-target="visualEditor" class="space-y-3">
        <div class="space-y-1">
          <%# Dynamic Rule Cards Container %>
          <div data-<%= identifier %>-target="rulesContainer" class="space-y-2"></div>

          <%# Add Rule Action Button %>
          <div class="pt-1">
            <button type="button" 
                    data-action="click-><%= identifier %>#addRule" 
                    class="rui-link-action">
              <span class="font-bold">+</span> <%= t('recurrence_ui.actions.add_rule', default: 'Add rule') %>
            </button>
          </div>
        </div>

        <%# Exceptions & Additional Dates Grid %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2 rui-divider">
          <div data-<%= identifier %>-target="exceptionsBlock" class="hidden">
            <%= render "recurrence_ui/exceptions", form: form, identifier: identifier, rec_ui: self, exdates: rules[:exdates] || [] %>
          </div>  
          
          <div data-<%= identifier %>-target="rdatesBlock" class="hidden">
            <%= render "recurrence_ui/rdates", form: form, identifier: identifier, rec_ui: self, rdates: rules[:rdates] || [] %>
          </div>
        </div>

        <%# Bottom Action Bar %>
        <div class="pt-2">
          <%= render "recurrence_ui/footer_actions", form: form, identifier: identifier, rec_ui: self %>
        </div>
      </div>

      <%# B. Raw JSON / Code Editor Panel %>
      <div data-<%= identifier %>-target="codeEditor" class="hidden space-y-3">
        <div>
          <label class="rui-label">
            <%= t('recurrence_ui.labels.raw_json', default: 'Raw JSON') %>
          </label>
          <textarea data-<%= identifier %>-target="iceCubeField" 
                    rows="6" 
                    class="rui-textarea font-mono text-xs w-full"></textarea>
        </div>
        <div class="flex items-center justify-end space-x-2">
          <button type="button" 
                  data-action="click-><%= identifier %>#toggleCodeEditor" 
                  class="rui-btn-secondary">
            <%= t('recurrence_ui.actions.cancel', default: 'Cancel') %>
          </button>
          <button type="button" 
                  data-action="click-><%= identifier %>#applyCodeChanges" 
                  class="rui-btn-primary">
            <%= t('recurrence_ui.actions.apply_code', default: 'Apply Code') %>
          </button>
        </div>
      </div>

    </div>

    <%# Rule Card Template for Dynamic JS Spawning %>
    <template data-<%= identifier %>-target="ruleCardTemplate">
      <%= render "recurrence_ui/rule_card", 
                 form: form, 
                 identifier: identifier, 
                 days_for_ui: days_for_ui, 
                 rec_ui: self, 
                 rule_options: rule_options %>
    </template>

    <%# Hidden Form Field for Rails submission %>
    <%= form.hidden_field field_name, value: rules_json, data: { "#{identifier}_target": "hiddenField" } %>
  </div>
<% end %>