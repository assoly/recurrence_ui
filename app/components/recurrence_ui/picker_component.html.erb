<%# app/components/recurrence_ui/picker_component.html.erb %>
<% I18n.with_locale(locale) do %>
  <div data-controller="<%= identifier %>" 
       data-<%= identifier %>-time-zone-value="<%= time_zone %>"
       data-<%= identifier %>-translations-value="<%= t('recurrence_ui', locale: locale).to_json %>"
       data-<%= identifier %>-locale-value="<%= locale %>"
       class="rui-container"
       data-rui-theme="<%= RecurrenceUi.configuration.theme_mode %>">  

    <%# 1. Секция полей времени, окончания и часового пояса (рендерится прямо внутри гема) %>
    <div class="space-y-4 pb-4 border-b border-[var(--rui-border-color)]">
  <!-- Контейнер сетки: на мобильных 1 колонка (друг под другом), на экранах sm и выше — ровно 3 колонки в ряд -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    <div>
      <%= form.label :start_at, t('recurrence_ui.labels.start_at'), class: "rui-label" %>
      <div class="grid grid-cols-2 gap-1">
        <div>
          <%= form.date_field :start_date, 
                value: record.start_at&.to_date || Date.today, 
                class: "rui-input w-full",
                data: { "#{identifier}_target": "startDate", action: "change->#{identifier}#calculate" } %>
        </div>
        <div>
          <%= form.time_field :start_time, 
                value: record.start_at&.strftime('%H:%M') || '09:00', 
                class: "rui-input",
                data: { "#{identifier}_target": "startTime", action: "change->#{identifier}#calculate" } %>
        </div>
      </div>  
    </div>
    <!-- 3. Временная зона -->
    <div>
      <%= form.label :time_zone, t('recurrence_ui.labels.time_zone'), class: "rui-label" %>
      <%= form.time_zone_select :time_zone, 
            ActiveSupport::TimeZone.us_zones, 
            { default: record.time_zone.presence || Time.zone.name }, 
            { class: "rui-input rui-select cursor-pointer w-full" } %>
    </div>

  </div>
</div>



<!-- Блок выбора: Окончание или Длительность -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
  
  <!-- Вариант 4.1: Длительность (активна по умолчанию) -->
  <div class="flex items-start space-x-3">
    <%= form.radio_button :duration_mode, :duration, 
          checked: true, 
          class: "mt-1 shrink-0",
          data: { "#{identifier}_target": "modeDuration", action: "change->#{identifier}#toggleDurationEndMode" } %>
    <div class="flex-1 min-w-0">
      <label class="rui-label"><%= t('recurrence_ui.labels.duration') %></label>
      
      <!-- Контейнер с flex-nowrap и gap-2, чтобы всё гарантированно было в одну строку -->
      <div class="flex flex-nowrap items-center gap-2 mt-1" data-<%= identifier %>-target="durationContainer">
        
        <!-- Дни -->
        <div class="flex items-center space-x-1 shrink-0">
          <%= form.number_field :duration_days, 
                value: 0, min: 0, 
                class: "rui-input w-16 text-center", 
                disabled: false,
                data: { "#{identifier}_target": "daysField" } %>
          <span class="text-sm text-gray-600"><%= t('recurrence_ui.duration.days.one', count: 1).gsub('1', '').strip %></span>
        </div>

        <!-- Часы -->
        <div class="flex items-center space-x-1 shrink-0">
          <%= form.number_field :duration_hours, 
                value: 1, min: 0, max: 23, 
                class: "rui-input w-16 text-center", 
                disabled: false,
                data: { "#{identifier}_target": "hoursField" } %>
          <span class="text-sm text-gray-600"><%= t('recurrence_ui.duration.hours.one', count: 1).gsub('1', '').strip %></span>
        </div>

        <!-- Минуты -->
        <div class="flex items-center space-x-1 shrink-0">
          <%= form.number_field :duration_minutes, 
                value: 0, min: 0, max: 59, 
                class: "rui-input w-16 text-center", 
                disabled: false,
                data: { "#{identifier}_target": "minutesField" } %>
          <span class="text-sm text-gray-600"><%= t('recurrence_ui.duration.minutes.one', count: 1).gsub('1', '').strip %></span>
        </div>

      </div>
    </div>
  </div>

  <!-- Вариант 4.2: Дата и время окончания (неактивны по умолчанию) -->
  <div class="flex items-start space-x-3">
    <%= form.radio_button :duration_mode, :end_at, 
          checked: false, 
          class: "mt-1 shrink-0",
          data: { "#{identifier}_target": "modeEnd", action: "change->#{identifier}#toggleDurationEndMode" } %>
    
    <div class="flex-1 min-w-0">
      <label class="rui-label"><%= t('recurrence_ui.labels.end_at') %></label>  
      <!-- Поля даты и времени окончания в ряд -->
      <div class="grid grid-cols-2 gap-1 mt-1">
        <div>
          <%= form.date_field :end_date, 
                value: record.end_at&.to_date || Date.today, 
                class: "rui-input w-full",
                data: { "#{identifier}_target": "endDate", action: "change->#{identifier}#calculate" } %>
        </div>
        <div>
          <%= form.time_field :end_time,
                value: record.end_at&.strftime('%H:%M') || '09:00', 
                class: ["rui-input", ("rui-input-error" if record.errors[:end_time].any?)],
                data: { "#{identifier}_target": "endTime" } %>
        </div>
      </div>
    </div>
  </div>

</div>
<div class="rui-panel-header flex items-center justify-between">
        <span class="rui-header-title">
          <%= t('recurrence_ui.labels.recurrence') %>
        </span>
    <%# 2. Summary Link Header (Сводка правила) %>
    <div class="pt-2">
      <%= render "recurrence_ui/summary_link", form: form, identifier: identifier, rec_ui: self %>
    </div>

    <%# 3. Main Edit Mode Panel %>
    <div data-<%= identifier %>-target="editMode" class="hidden space-y-3 pt-2">  
      
      <%# Header bar with Code Editor toggle %>
      <div class="rui-panel-header flex items-center justify-between">
        <span class="rui-header-title">
          <%= t('recurrence_ui.labels.recurrence') %>
        </span>
        <button type="button" 
                data-action="click-><%= identifier %>#toggleCodeEditor" 
                title="<%= t('recurrence_ui.actions.code_mode') %>"
                class="rui-btn-secondary font-mono text-xs px-2 py-1">
          &lt;/&gt;
        </button>
      </div>

      <%# A. Visual Rule Editor Section %>
      <div data-<%= identifier %>-target="visualEditor" class="space-y-3">
        <div class="space-y-1">
          <%# Dynamic Rule Cards Container %>
          <div data-<%= identifier %>-target="rulesContainer" class="space-y-2"></div>

          <%# Add Rule Action Button %>
          <div class="pt-1">
            <button type="button" 
                    data-action="click-><%= identifier %>#addRule" 
                    class="rui-link-action">
              <span class="font-bold">+</span> <%= t('recurrence_ui.actions.add_rule', default: 'Add rule') %>
            </button>
          </div>
        </div>

        <%# Exceptions & Additional Dates Grid %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2 rui-divider">
          <div data-<%= identifier %>-target="rdatesBlock" class="hidden">
            <%= render "recurrence_ui/rdates", form: form, identifier: identifier, rec_ui: self, rdates: rules[:rdates] || [] %>
          </div>
          <div data-<%= identifier %>-target="exceptionsBlock" class="hidden">
            <%= render "recurrence_ui/exceptions", form: form, identifier: identifier, rec_ui: self, exdates: rules[:exdates] || [] %>
          </div>            
        </div>

        <%# Bottom Action Bar %>
        <div class="pt-2">
          <%= render "recurrence_ui/footer_actions", form: form, identifier: identifier, rec_ui: self %>
        </div>
      </div>

      <%# B. Raw JSON / Code Editor Panel %>
      <div data-<%= identifier %>-target="codeEditor" class="hidden space-y-3">
        <div>
          <label class="rui-label">
            <%= t('recurrence_ui.labels.raw_json', default: 'Raw JSON') %>
          </label>
          <textarea data-<%= identifier %>-target="iceCubeField" 
                    rows="6" 
                    class="rui-textarea font-mono text-xs w-full"></textarea>
        </div>
        <div class="flex items-center justify-end space-x-2">
          <button type="button" 
                  data-action="click-><%= identifier %>#toggleCodeEditor" 
                  class="rui-btn-secondary">
            <%= t('recurrence_ui.actions.cancel') %>
          </button>
          <button type="button" 
                  data-action="click-><%= identifier %>#applyCodeChanges" 
                  class="rui-btn-primary">
            <%= t('recurrence_ui.actions.apply_code') %>
          </button>
        </div>
      </div>

    </div>

    <%# Rule Card Template for Dynamic JS Spawning %>
    <template data-<%= identifier %>-target="ruleCardTemplate">
      <%= render "recurrence_ui/rule_card", 
                 form: form, 
                 identifier: identifier, 
                 days_for_ui: days_for_ui, 
                 rec_ui: self, 
                 rule_options: rule_options %>
    </template>

    <%# Hidden Form Field for Rails submission %>
    <%= form.hidden_field field_name, value: rules_json, data: { "#{identifier}_target": "hiddenField" } %>
  </div>
  </div>
<% end %>