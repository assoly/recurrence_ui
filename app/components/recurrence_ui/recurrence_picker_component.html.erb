<%# app/components/recurrence_ui/recurrence_picker_component.html.erb %>
<% I18n.with_locale(locale) do %>
  <div data-controller="<%= identifier %>" 
       data-<%= identifier %>-time-zone-value="<%= time_zone %>"
       data-<%= identifier %>-translations-value="<%= t('recurrence_ui', locale: locale).to_json %>"
       data-<%= identifier %>-locale-value="<%= locale %>"
       class="rui-container"
       data-rui-theme="<%= RecurrenceUi.configuration.theme_mode %>">  

    <%# 1. Секция полей времени, окончания и часового пояса %>
    <div class="space-y-4 pb-4 border-b border-[var(--rui-border-color)]">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        
        <!-- 1. Дата и время начала (всегда на одной строке, не тянутся) -->
        <div>
          <%= form.label :start_at, t('recurrence_ui.labels.start_at'), class: "rui-label block" %>
          <div class="flex items-center space-x-2 mt-1">
            <%= form.date_field :form_start_date, 
      value: initial_start_at&.to_date || Date.current,                  
      class: "rui-input w-36 shrink-0",
                  data: { "#{identifier}_target": "startDate", action: "change->#{identifier}#calculateEndDateFromDuration" } %>
            <%= form.time_field :form_start_time, 
                  value: initial_start_at&.strftime('%H:%M') || '09:00', 
                  class: "rui-input w-24 shrink-0",
                  data: { "#{identifier}_target": "startTime", action: "change->#{identifier}#calculateEndDateFromDuration" } %>
          </div>  
        </div>

        <!-- Часовой пояс -->
        <div>
          <%= form.label :time_zone, t('recurrence_ui.labels.time_zone'), class: "rui-label block" %>
          <%= form.time_zone_select :time_zone, 
                ActiveSupport::TimeZone.all, 
                { default: record.public_send(time_zone_field).presence || Time.zone.name }, 
                { class: "rui-input rui-select cursor-pointer w-full mt-1" } %>
        </div>

      </div>
    </div>

<!-- Блок выбора: Длительность или Окончание -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4">
  
  <!-- Вариант 4.1: Длительность -->
  <label class="flex items-start space-x-3 p-2 rounded-lg transition-colors cursor-pointer hover:bg-[var(--rui-hover-bg-soft)]">
  <%= form.radio_button :form_duration_mode, :duration,
        checked: (initial_form_duration_mode == :duration),
        class: "mt-1 shrink-0",
        data: { "#{identifier}_target": "modeDuration", action: "change->#{identifier}#toggleDurationEndMode" } %>

  <div class="flex-1 min-w-0">
    <span class="rui-label font-medium select-none">
      <%= t('recurrence_ui.labels.duration') %>
    </span>

    <div class="flex flex-nowrap items-start gap-3 mt-2"
         data-<%= identifier %>-target="durationContainer">

      <%# Дни %>
      <div class="flex flex-col items-center gap-1 shrink-0"
           onclick="event.stopPropagation()">
        <span class="rui-duration-unit">
          <%= t('recurrence_ui.duration.form_days') %>
        </span>

        <%= form.number_field :form_duration_days,
              value: initial_form_duration_days,
              min: 0,
              class: "rui-input w-16 text-center",
              data: { "#{identifier}_target": "daysField", action: "change->#{identifier}#calculateEndDateFromDuration" } %>
      </div>

      <%# Часы %>
      <div class="flex flex-col items-center gap-1 shrink-0"
           onclick="event.stopPropagation()">
        <span class="rui-duration-unit">
          <%= t('recurrence_ui.duration.form_hours') %>
        </span>

        <%= form.number_field :form_duration_hours,
              value: initial_form_duration_hours,
              min: 0,
              max: 23,
              class: "rui-input w-16 text-center",
              data: { "#{identifier}_target": "hoursField", action: "change->#{identifier}#calculateEndDateFromDuration" } %>
      </div>

      <%# Минуты %>
      <div class="flex flex-col items-center gap-1 shrink-0"
           onclick="event.stopPropagation()">
        <span class="rui-duration-unit">
          <%= t('recurrence_ui.duration.form_minutes') %>
        </span>

        <%= form.number_field :form_duration_minutes,
              value: initial_form_duration_minutes,
              min: 0,
              max: 59,
              class: "rui-input w-16 text-center",
              data: { "#{identifier}_target": "minutesField", action: "change->#{identifier}#calculateEndDateFromDuration" } %>
      </div>

    </div>
  </div>
</label>

  <!-- Вариант 4.2: Дата и время окончания -->
  <label class="flex items-start space-x-3 p-2 rounded-lg transition-colors cursor-pointer hover:bg-[var(--rui-hover-bg-soft)]">
    <%= form.radio_button :form_duration_mode, :end_at, 
          checked: (initial_form_duration_mode == :end_at), 
          class: "mt-1 shrink-0",
          data: { "#{identifier}_target": "modeEnd", action: "change->#{identifier}#toggleDurationEndMode" } %>
    
    <div class="flex-1 min-w-0">
      <span class="rui-label"><%= t('recurrence_ui.labels.end_at') %></span>  
      
      <!-- Поля даты и времени окончания -->
      <div class="flex items-center space-x-2 mt-1" onclick="event.stopPropagation()">
        <%= form.date_field :form_end_date, 
              value: initial_end_at&.to_date || Date.current, 
              class: "rui-input w-36 shrink-0 disabled:opacity-50 disabled:--rui-input-disabled-bg disabled:cursor-not-allowed",
              disabled: (initial_form_duration_mode != :end_at),
              data: { "#{identifier}_target": "endDateField"} %>
        <%= form.time_field :form_end_time,
              value: initial_end_at&.strftime('%H:%M') || '09:00', 
              class: ["rui-input w-24 shrink-0 disabled:opacity-50 disabled:--rui-input-disabled-bg disabled:cursor-not-allowed", ("rui-input-error" if record.errors[:form_end_time].any?)],
              disabled: (initial_form_duration_mode != :end_at),
              data: { "#{identifier}_target": "endTimeField" } %>
      </div>
    </div>
  </label>

</div>

    <!-- 4. При показе саммари: только заголовок Повторение и саммари под ним -->
    <div data-<%= identifier %>-target="displayMode" class="space-y-1">
      <div class="rui-panel-header">
        <span class="rui-label">
          <%= t('recurrence_ui.labels.recurrence') %>
        </span>
      </div>
      <div>
        <%= render "recurrence_ui/summary_link", form: form, identifier: identifier, rec_ui: self %>
      </div>
    </div>

    <!-- 5. Режим редактирования: заголовок Повторение + кнопка кода напротив, все поля под ними -->
    <div data-<%= identifier %>-target="editMode" class="hidden space-y-3 pt-2">  
      
      <!-- Шапка с кнопкой кода справа напротив заголовка Повторение -->
      <div class="rui-panel-header flex items-center justify-between">
        <span class="rui-header-title">
          <%= t('recurrence_ui.labels.recurrence') %>
        </span>
        <button type="button" 
                data-action="click-><%= identifier %>#toggleCodeEditor" 
                title="<%= t('recurrence_ui.actions.code_mode') %>"
                class="rui-btn-secondary font-mono text-xs px-2 py-1">
          &lt;/&gt;
        </button>
      </div>

      <%# Visual Rule Editor Section %>
      <div data-<%= identifier %>-target="visualEditor" class="space-y-3">
        <div class="space-y-1">
          <%# Dynamic Rule Cards Container %>
          <div data-<%= identifier %>-target="rulesContainer" class="space-y-2"></div>

          <%# Add Rule Action Button %>
          <div class="pt-1">
            <button type="button" 
                    data-action="click-><%= identifier %>#addRule" 
                    class="rui-link-action">
              <span class="font-bold">+</span> <%= t('recurrence_ui.actions.add_rule', default: 'Add rule') %>
            </button>
          </div>
        </div>

        <%# Exceptions & Additional Dates Grid %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2 rui-divider">
          <div data-<%= identifier %>-target="rdatesBlock" class="hidden">
            <%= render "recurrence_ui/rdates", form: form, identifier: identifier, rec_ui: self, rdates: rules[:rdates] || [] %>
          </div>
          <div data-<%= identifier %>-target="exceptionsBlock" class="hidden">
            <%= render "recurrence_ui/exceptions", form: form, identifier: identifier, rec_ui: self, exdates: rules[:exdates] || [] %>
          </div>            
        </div>

        <%# Bottom Action Bar %>
        <div class="pt-2">
          <%= render "recurrence_ui/footer_actions", form: form, identifier: identifier, rec_ui: self %>
        </div>
      </div>

      <%# Raw JSON / Code Editor Panel %>
      <div data-<%= identifier %>-target="codeEditor" class="hidden space-y-3">
        <div>
          <label class="rui-label">
            <%= t('recurrence_ui.labels.raw_json', default: 'Raw JSON') %>
          </label>
          <textarea data-<%= identifier %>-target="iceCubeField" 
                    rows="6" 
                    class="rui-textarea font-mono text-xs w-full"></textarea>
        </div>
        <div class="flex items-center justify-end space-x-2">
          <button type="button" 
                  data-action="click-><%= identifier %>#toggleCodeEditor" 
                  class="rui-btn-secondary">
            <%= t('recurrence_ui.actions.cancel') %>
          </button>
          <button type="button" 
                  data-action="click-><%= identifier %>#applyCodeChanges" 
                  class="rui-btn-primary">
            <%= t('recurrence_ui.actions.apply_code') %>
          </button>
        </div>
      </div>

    </div>

    <%# Rule Card Template %>
    <template data-<%= identifier %>-target="ruleCardTemplate">
      <%= render "recurrence_ui/rule_card", 
                 form: form, 
                 identifier: identifier, 
                 days_for_ui: days_for_ui, 
                 rec_ui: self, 
                 rule_options: rule_options %>
    </template>

    <%# Hidden Form Field %>
    <%= form.hidden_field field_name, value: rules_json, data: { "#{identifier}_target": "hiddenField" } %>
  </div>
<% end %>