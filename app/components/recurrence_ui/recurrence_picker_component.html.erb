<%# app/components/recurrence_ui/recurrence_picker_component.html.erb %>
<% I18n.with_locale(locale) do %>
  <div data-controller="<%= identifier %>" 
       data-<%= identifier %>-time-zone-value="<%= time_zone %>"
       data-<%= identifier %>-translations-value="<%= t('recurrence_ui', locale: locale).to_json %>"
       data-<%= identifier %>-locale-value="<%= locale %>"
       class="rui-container"
       data-rui-theme="<%= RecurrenceUi.configuration.theme_mode %>">  

    <%# 1. Секция полей времени начала и часового пояса %>
    <div class="rui-grid-row">
      <% if show_start_date_time? %>
        <div class="rui-grid-col">
          <%= render "recurrence_ui/start_at", form: form, identifier: identifier, rec_ui: self %>
        </div>
      <% end %>

      <% if show_time_zone? %>
        <div class="rui-grid-col">
          <%= render "recurrence_ui/time_zone", form: form, identifier: identifier, rec_ui: self %>
        </div>
      <% end %>
      
      <%# 2. Блок выбора: Длительность и/или Окончание %>
      <% if show_duration? && show_end_date_time? %>
        <div class="rui-grid-row" style="width: 100%;">
        
          <!-- Карточка Длительности -->
          <label class="rui-grid-col rui-card-option">
            <%= form.radio_button :form_duration_mode, :duration, 
                  checked: (initial_form_duration_mode == :duration), 
                  class: "rui-radio",
                  data: { "#{identifier}_target": "modeDuration", action: "change->#{identifier}#toggleDurationEndMode" } %>
            <div style="flex: 1; min-width: 0;">
              <span class="rui-label" style="text-transform: none;"><%= t('recurrence_ui.labels.duration') %></span>
              <div style="margin-top: 0.25rem;" onclick="event.stopPropagation()">
                <%= render "recurrence_ui/duration", form: form, identifier: identifier, rec_ui: self %>
              </div>
            </div>
          </label>

          <!-- Карточка Окончания -->
          <label class="rui-grid-col rui-card-option">
            <%= form.radio_button :form_duration_mode, :end_at, 
                  checked: (initial_form_duration_mode == :end_at), 
                  class: "rui-radio",
                  data: { "#{identifier}_target": "modeEnd", action: "change->#{identifier}#toggleDurationEndMode" } %>
            <div style="flex: 1; min-width: 0;">
              <span class="rui-label" style="text-transform: none;"><%= t('recurrence_ui.labels.end_at') %></span>  
              <div style="margin-top: 0.25rem;" onclick="event.stopPropagation()">
                <%= render "recurrence_ui/end_at", form: form, identifier: identifier, rec_ui: self %>
              </div>
            </div>
          </label>
        </div>
      <% elsif show_duration? %>
        <div class="rui-grid-col">
          <span class="rui-label" style="text-transform: none; margin-bottom: 0.25rem;"><%= t('recurrence_ui.labels.duration') %></span>
          <%= render "recurrence_ui/duration", form: form, identifier: identifier, rec_ui: self %>
        </div>
      <% elsif show_end_date_time? %>
        <div class="rui-grid-col">
          <span class="rui-label" style="text-transform: none; margin-bottom: 0.25rem;"><%= t('recurrence_ui.labels.end_at') %></span>  
          <%= render "recurrence_ui/end_at", form: form, identifier: identifier, rec_ui: self %>
        </div>
      <% end %>
    </div>

    <!-- 3. Саммари -->
    <div data-<%= identifier %>-target="displayMode" style="display: flex; flex-direction: column; gap: 0.25rem;">
      <div class="rui-panel-header">
        <span class="rui-label">
          <%= t('recurrence_ui.labels.recurrence') %>
        </span>
      </div>
      <div>
        <%= render "recurrence_ui/summary_link", form: form, identifier: identifier, rec_ui: self %>
      </div>
    </div>

    <!-- Режим редактирования -->
    <div data-<%= identifier %>-target="editMode" class="rui-hidden" style="display: flex; flex-direction: column; gap: 0.75rem; padding-top: 0.5rem;">  
      <div class="rui-panel-header">
        <span class="rui-header-title">
          <%= t('recurrence_ui.labels.recurrence') %>
        </span>
        <button type="button" 
                data-action="click-><%= identifier %>#toggleCodeEditor" 
                title="<%= t('recurrence_ui.actions.code_mode') %>"
                class="rui-btn-secondary" style="font-family: monospace; font-size: 0.75rem; padding: 0.25rem 0.5rem;">
          &lt;/&gt;
        </button>
      </div>

      <div data-<%= identifier %>-target="visualEditor" style="display: flex; flex-direction: column; gap: 0.75rem;">
        
        <% if allow_multiple_rules %>
          <div style="display: flex; flex-direction: column; gap: 0.25rem;">
            <div data-<%= identifier %>-target="rulesContainer" style="display: flex; flex-direction: column; gap: 0.5rem;"></div>
            <div style="padding-top: 0.25rem;">
              <button type="button" 
                      data-action="click-><%= identifier %>#addRule" 
                      class="rui-link-action">
                <span style="font-weight: bold;">+</span> <%= t('recurrence_ui.actions.add_rule', default: 'Add rule') %>
              </button>
            </div>
          </div>
        <% else %>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <%= render "recurrence_ui/single_rule", form: form, identifier: identifier, days_for_ui: days_for_ui, rec_ui: self, rule_options: rule_options %>
          </div>
        <% end %>

        <div class="rui-grid-2 rui-divider" style="padding-top: 0.5rem;">
          <% if show_rdates %>
            <div data-<%= identifier %>-target="rdatesBlock" class="rui-hidden">
              <%= render "recurrence_ui/rdates", form: form, identifier: identifier, rec_ui: self, rdates: rules[:rdates] || [] %>
            </div>
          <% end %>
          <% if show_exceptions %>
            <div data-<%= identifier %>-target="exceptionsBlock" class="rui-hidden">
              <%= render "recurrence_ui/exceptions", form: form, identifier: identifier, rec_ui: self, exdates: rules[:exdates] || [] %>
            </div>            
          <% end %>
        </div>

        <div style="padding-top: 0.5rem;">
          <%= render "recurrence_ui/footer_actions", form: form, identifier: identifier, rec_ui: self %>
        </div>
      </div>

      <div data-<%= identifier %>-target="codeEditor" class="rui-hidden" style="display: flex; flex-direction: column; gap: 0.75rem;">
        <div>
          <label class="rui-label"><%= t('recurrence_ui.labels.raw_json', default: 'Raw JSON') %></label>
          <textarea data-<%= identifier %>-target="iceCubeField" rows="6" class="rui-textarea" style="width: 100%;"></textarea>
        </div>
        <div style="display: flex; align-items: center; justify-content: flex-end; gap: 0.5rem;">
          <button type="button" data-action="click-><%= identifier %>#toggleCodeEditor" class="rui-btn-secondary">
            <%= t('recurrence_ui.actions.cancel') %>
          </button>
          <button type="button" data-action="click-><%= identifier %>#applyCodeChanges" class="rui-btn-primary">
            <%= t('recurrence_ui.actions.apply_code') %>
          </button>
        </div>
      </div>
    </div>

    <% if allow_multiple_rules %>
      <template data-<%= identifier %>-target="ruleCardTemplate">
        <%= render "recurrence_ui/rule_card", 
                   form: form, 
                   identifier: identifier, 
                   days_for_ui: days_for_ui, 
                   rec_ui: self, 
                   rule_options: rule_options %>
      </template>
    <% end %>

    <%= form.hidden_field field_name, value: rules_json, data: { "#{identifier}_target": "hiddenField" } %>
  </div>
<% end %>