<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Recurrence UI Dev Previews</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Подключение Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Подключение JS-модулей -->
  <% if respond_to?(:javascript_importmap_tags) && Rails.application.config.respond_to?(:importmap) %>
    <%= javascript_importmap_tags %>
  <% else %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module", defer: true %>
  <% end %>
</head>
<body class="bg-gray-100 p-8">
  <div class="max-w-7xl mx-auto">
    <%= yield %>
  </div>
</body>
</html>