<%# app/views/recurrence_ui/_daily.html.erb %>
<%# Daily Recurrence Rule Options %>
<div class="space-y-3" data-item="specificFields" data-rule="daily">
  <div class="flex items-center space-x-2">
    <span class="rui-inline-label">
      <%= t("recurrence_ui.labels.every", default: "Every") %>
    </span>

    <%= number_field_tag nil, rec_ui.initial_interval, 
          min: 1, 
          class: "rui-input w-16 text-center",
          data: { 
            item: "interval", 
            action: "input->#{identifier}#onCardInputChanged" 
          } %> 

    <span class="rui-inline-label">
      <%= t("recurrence_ui.labels.day", default: "day(s)") %>
    </span>
  </div>
</div>