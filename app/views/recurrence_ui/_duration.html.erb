<%# Duration #%>
<label class="flex items-start space-x-3 p-2 rounded-lg transition-colors cursor-pointer hover:bg-[var(--rui-hover-bg-soft)]">
  <%= form.radio_button :form_duration_mode, :duration,
        checked: (rec_ui.initial_form_duration_mode == :duration),
        class: "mt-1 shrink-0",
        data: { "#{identifier}_target": "modeDuration", action: "change->#{identifier}#toggleDurationEndMode" } %>

  <div class="flex-1 min-w-0">
    <span class="rui-label font-medium select-none">
      <%= t('recurrence_ui.labels.duration') %>
    </span>

    <div class="flex flex-nowrap items-start gap-3 mt-2"
         data-<%= identifier %>-target="durationContainer">

      <%# Дни %>
      <div class="flex flex-col items-center gap-1 shrink-0"
           onclick="event.stopPropagation()">
        <span class="rui-duration-unit">
          <%= t('recurrence_ui.duration.form_days') %>
        </span>

        <%= form.number_field :form_duration_days,
              value: rec_ui.initial_form_duration_days,
              min: 0,
              class: "rui-input w-16 text-center",
              data: { "#{identifier}_target": "daysField", action: "change->#{identifier}#calculateEndDateFromDuration" } %>
      </div>

      <%# Часы %>
      <div class="flex flex-col items-center gap-1 shrink-0"
           onclick="event.stopPropagation()">
        <span class="rui-duration-unit">
          <%= t('recurrence_ui.duration.form_hours') %>
        </span>

        <%= form.number_field :form_duration_hours,
              value: rec_ui.initial_form_duration_hours,
              min: 0,
              max: 23,
              class: "rui-input w-16 text-center",
              data: { "#{identifier}_target": "hoursField", action: "change->#{identifier}#calculateEndDateFromDuration" } %>
      </div>

      <%# Минуты %>
      <div class="flex flex-col items-center gap-1 shrink-0"
           onclick="event.stopPropagation()">
        <span class="rui-duration-unit">
          <%= t('recurrence_ui.duration.form_minutes') %>
        </span>

        <%= form.number_field :form_duration_minutes,
              value: rec_ui.initial_form_duration_minutes,
              min: 0,
              max: 59,
              class: "rui-input w-16 text-center",
              data: { "#{identifier}_target": "minutesField", action: "change->#{identifier}#calculateEndDateFromDuration" } %>
      </div>

    </div>
  </div>
</label>