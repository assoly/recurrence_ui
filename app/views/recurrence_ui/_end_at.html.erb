<%# app/views/recurrence_ui/_end_at.html.erb %>

<div class="rui-end-at-row" onclick="event.stopPropagation()">
  <%= form.date_field :form_end_date, 
        value: form.object.end_time_in_zone(:event)&.to_date || Date.current, 
        disabled: (rec_ui.initial_form_duration_mode != :end_at && rec_ui.show_duration),
        class: "rui-input rui-input-date #{'rui-input-error' if form.object.errors[:form_end_date].any?}",
        data: { "#{identifier}_target": "endDateField" } %>

  <%= form.time_field :form_end_time,
        value: form.object.end_time_in_zone(:event),
        disabled: (rec_ui.initial_form_duration_mode != :end_at && rec_ui.show_duration),
        class: "rui-input rui-input-time #{'rui-input-error' if form.object.errors[:form_end_time].any?}",
        data: { "#{identifier}_target": "endTimeField" } %>
</div>