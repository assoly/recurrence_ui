<%# app/views/recurrence_ui/_exceptions.html.erb %>
<%# Excluded Dates (EXDATES) Section %>
<div class="rui-exceptions-container">
  <%# 1. Section Label %>
  <label class="rui-label rui-exceptions-label">
    <span>🚫</span> <%= t("recurrence_ui.labels.exceptions", locale: locale, default: "Exceptions") %>
  </label>

  <%# 2. Container for EXDATE Chips %>
  <div data-<%= identifier %>-target="exdatesContainer" class="rui-chip-container">
    <% exdates.each do |exdate| %>
      <% date_str = exdate.is_a?(Date) || exdate.is_a?(Time) ? exdate.strftime("%Y-%m-%d") : exdate.to_s %>
      <span class="rui-chip rui-chip--exdate" data-exdate-value="<%= date_str %>">
        <button type="button" 
                data-action="click-><%= identifier %>#removeExdate" 
                class="rui-chip__remove-btn" 
                title="<%= t('recurrence_ui.actions.remove', default: 'Delete') %>">✕</button>
        <span><%= rec_ui._formatDate(date_str) rescue date_str %></span>
      </span>
    <% end %>
  </div>

  <%# 3. Date Input and Add Button %>
  <div class="rui-exceptions-input-group">
    <input type="date" 
           data-<%= identifier %>-target="exdateInput" 
           data-action="input-><%= identifier %>#onDateInputChange"
           class="rui-input rui-exceptions-date-input">
    
    <button type="button" 
            data-<%= identifier %>-target="addExdateBtn"
            data-action="click-><%= identifier %>#addExdate" 
            disabled
            title="<%= t('recurrence_ui.actions.add_exdate', default: 'Add exception') %>"
            class="rui-btn rui-btn-primary rui-exceptions-add-btn">
      +
    </button>
  </div>
</div>

<%# 4. Template for Dynamically Generated EXDATE Chips via JS %>
<template data-<%= identifier %>-target="exdateTemplate">
  <span class="rui-chip rui-chip--exdate" data-exdate-value="VALUE">
    <button type="button" 
            data-action="click-><%= identifier %>#removeExdate" 
            class="rui-chip__remove-btn" 
            title="<%= t('recurrence_ui.actions.remove', default: 'Delete') %>">✕</button>
    <span>LABEL</span>
  </span>
</template>