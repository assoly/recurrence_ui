<%# app/views/recurrence_ui/_exceptions.html.erb %>
  <h4 class="text-md font-medium text-gray-700 mb-2">🚫 <%= t("recurrence_ui.labels.exceptions") %></h4>

  <div data-<%= identifier %>-target="exdatesContainer" class="flex flex-wrap gap-2 mb-4">
    <% exdates.each do |date_str| %>
      <%# Рендерим начальные данные через хелпер, чтобы не дублировать верстку плашки вручную %>
      <%= render "recurrence_ui/exdate_badge", date: date_str.to_date, identifier: identifier, rec_ui: rec_ui %>
    <% end %>
  </div>

  <div class="flex items-center gap-2">
    <input type="date" 
           data-<%= identifier %>-target="exdateInput" 
           class="block w-full max-w-[200px] border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
    
    <button type="button" 
            data-action="click-><%= identifier %>#addExdate" 
            class="inline-flex items-center px-4 py-2 border border-blue-600 text-sm font-medium rounded-md text-blue-600 bg-white hover:bg-blue-50 transition-colors">
      <%= t("recurrence_ui.labels.add_exception") %>
    </button>
  </div>
<%# шаблон для JS %>
<template data-<%= identifier %>-target="exdateTemplate">
  <%= render "recurrence_ui/exdate_badge", date: nil, identifier: identifier, template: true %>
</template>