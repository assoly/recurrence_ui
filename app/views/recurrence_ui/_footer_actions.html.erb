<%# app/views/recurrence_ui/_footer_actions.html.erb %>
<%# Footer Action Buttons (Cancel / Save) %>
<div class="rui-divider flex justify-end gap-2 pt-3 mt-3">
  <%# Cancel Editing Button %>
  <button type="button" 
          data-action="click-><%= identifier %>#cancelEdit" 
          class="rui-btn rui-btn--secondary">
    <%= t("recurrence_ui.actions.cancel", default: "Cancel") %>
  </button>

  <%# Save/Apply Changes Button %>
  <button type="button" 
          data-action="click-><%= identifier %>#saveRule" 
          class="rui-btn rui-btn--primary">
    <%= t("recurrence_ui.actions.save", default: "OK") %>
  </button>
</div>