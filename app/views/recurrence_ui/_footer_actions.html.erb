<%# app/views/recurrence_ui/_footer_actions.html.erb %>

<%# БЛОК: Кнопки управления режимом редактирования %>
<div class="flex justify-end space-x-3 mt-4 pt-3 border-t border-gray-200">
  <button type="button" 
          data-action="click-><%= identifier %>#cancelEdit" 
          class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
    <%= t("recurrence_ui.actions.cancel", default: "Cancel") %>
  </button>
  <button type="button" 
          data-action="click-><%= identifier %>#saveRule" 
          class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md shadow-sm hover:bg-blue-700">
    <%= t("recurrence_ui.actions.save", default: "OK") %>
  </button>
</div>

<%# БЛОК: Видимое поле для IceCube Хэша (Отладка — только для dev) %>
<% if Rails.env.development? %>
  <div class="mt-6 pt-4 border-t border-gray-200">
    <h4 class="text-md font-medium text-gray-700 mb-2">🔍 IceCube Hash (Debug)</h4>
    <p class="text-sm text-gray-500 mb-3">
      <%= t("recurrence_ui.debug_hint", default: "Hidden field contents. You can edit this directly for testing!") %>
    </p>

    <textarea 
        class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm h-32 font-mono text-xs"
        data-<%= identifier %>-target="iceCubeField"
        data-action="input-><%= identifier %>#updateHiddenFromDebug">
    </textarea>
  </div>
<% end %>