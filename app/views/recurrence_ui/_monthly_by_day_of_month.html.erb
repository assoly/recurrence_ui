<%# app/views/recurrence_ui/_monthly_by_day_of_month.html.erb %>
<% selected_days_for_monthly = local_assigns.fetch(:selected_days_for_monthly, {}) %>
<div class="space-y-4">
  <div class="flex items-center space-x-2 mb-3">
    <span class="text-gray-700"><%= t("recurrence_ui.every") %></span>
    
    <%# 1. ИНПУТ ИНТЕРВАЛА: добавляем событие input->identifier#onCardInputChanged %>
    <%= number_field_tag nil, rec_ui.initial_interval, 
          min: 1, 
          class: "w-16 text-center border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500",
          data: { 
            item: "interval", 
            action: "input->#{identifier}#onCardInputChanged" 
          } %> 
    
    <span class="text-gray-700">
      <%= t("recurrence_ui.labels.month") %>
    </span>
  </div>

  <div data-<%= identifier %>-target="monthlyDays">
    <p class="text-sm font-medium text-gray-700 mb-2"><%= t("recurrence_ui.labels.select_dates") %>:</p>
    
      <div class="grid grid-cols-8 gap-1 items-center">
        <div class="col-span-1 text-[10px] text-gray-500 uppercase font-bold text-right pr-1">
          &nbsp;
        </div>
        <div class="col-span-7 grid grid-cols-7 gap-1">
            <% (1..31).each do |day| %>
                <% is_selected = selected_days_for_monthly.to_a.include?(day) %> 
                
                <%# 2. КНОПКИ ДНЕЙ: вызываем toggleDay (внутри которого теперь вызывается updateCardSummary) %>
                <button type="button" 
                        class="w-full py-2 rounded-md flex items-center justify-center text-xs font-medium border transition-all
                           bg-white text-gray-700 border-gray-300 hover:bg-blue-50
                           data-[selected='true']:bg-blue-600 data-[selected='true']:text-white data-[selected='true']:border-blue-600"
                        data-day="<%= day %>"
                        data-<%= identifier %>-target="dayButton"
                        data-selected="<%= is_selected %>"
                        data-action="click-><%= identifier %>#toggleDay">
                <%= day %>
                </button>
            <% end %>
        </div>
      </div>
  </div>
</div>