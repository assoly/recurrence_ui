<%# app/views/recurrence_ui/_monthly_by_day_of_month.html.erb %>
<%# Monthly Recurrence Rule Options (By Day of Month) %>
<% selected_days_for_monthly = local_assigns.fetch(:selected_days_for_monthly, {}) %>

<div class="space-y-3" data-item="specificFields" data-rule="monthly_by_day_of_month">
  <%# Interval Input Header %>
  <div class="flex items-center space-x-2">
    <span class="rui-inline-label">
      <%= t("recurrence_ui.labels.every", default: "Every") %>
    </span>
    
    <%= number_field_tag nil, rec_ui.initial_interval, 
          min: 1, 
          class: "rui-input w-16 text-center",
          data: { 
            item: "interval", 
            action: "input->#{identifier}#onCardInputChanged" 
          } %> 
    
    <span class="rui-inline-label">
      <%= t("recurrence_ui.labels.month", count: rec_ui.initial_interval, default: "month(s)") %>
    </span>
  </div>

  <%# Month Days Selection Section %>
  <div data-<%= identifier %>-target="monthlyDays">
    <label class="rui-label mb-2">
      <%= t("recurrence_ui.labels.select_dates", default: "Select dates") %>:
    </label>
    
    <div class="grid grid-cols-7 gap-1">
      <% (1..31).each do |day| %>
        <% is_selected = selected_days_for_monthly.to_a.include?(day) %> 
        
        <button type="button" 
                class="rui-day-btn"
                data-day="<%= day %>"
                data-<%= identifier %>-target="dayButton"
                data-selected="<%= is_selected %>"
                data-action="click-><%= identifier %>#toggleDay">
          <%= day %>
        </button>
      <% end %>
    </div>
  </div>
</div>