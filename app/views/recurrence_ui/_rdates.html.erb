<%# app/views/recurrence_ui/_rdates.html.erb %>
<%# Additional Dates (RDATES) Section %>
<div class="rui-rdates-container">
  <%# 1. Section Label %>
  <label class="rui-label rui-rdates-label">
    <span>✅</span> <%= t("recurrence_ui.labels.rdates", locale: locale, default: "Additional Dates") %>
  </label>

  <%# 2. Container for RDATE Chips %>
  <div data-<%= identifier %>-target="rdatesContainer" class="rui-chip-container">
    <% rdates.each do |rdate| %>
      <% date_str = rdate.is_a?(Date) || rdate.is_a?(Time) ? rdate.strftime("%Y-%m-%d") : rdate.to_s %>
      <span class="rui-chip rui-chip--rdate" data-rdate-value="<%= date_str %>">
        <button type="button" 
                data-action="click-><%= identifier %>#removeRdate" 
                class="rui-chip__remove-btn" 
                title="<%= t('recurrence_ui.actions.remove', default: 'Delete') %>">✕</button>
        <span><%= rec_ui._formatDate(date_str) rescue date_str %></span>
      </span>
    <% end %>
  </div>

  <%# 3. Date Input and Add Button %>
  <div class="rui-rdates-input-group">
    <input type="date" 
           data-<%= identifier %>-target="rdateInput" 
           data-action="input-><%= identifier %>#onDateInputChange"
           class="rui-input rui-rdates-date-input">
    
    <button type="button" 
            data-<%= identifier %>-target="addRdateBtn"
            data-action="click-><%= identifier %>#addRdate" 
            disabled
            title="<%= t('recurrence_ui.actions.add_rdate', default: 'Add date') %>"
            class="rui-btn rui-btn-primary rui-rdates-add-btn">
      +
    </button>
  </div>
</div>

<%# 4. Template for Dynamically Generated RDATE Chips via JS %>
<template data-<%= identifier %>-target="rdateTemplate">
  <span class="rui-chip rui-chip--rdate" data-rdate-value="VALUE">
    <button type="button" 
            data-action="click-><%= identifier %>#removeRdate" 
            class="rui-chip__remove-btn" 
            title="<%= t('recurrence_ui.actions.remove', default: 'Delete') %>">✕</button>
    <span>LABEL</span>
  </span>
</template>