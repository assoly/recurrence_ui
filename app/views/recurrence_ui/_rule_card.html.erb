<%# app/views/recurrence_ui/_rule_card.html.erb %>
<div data-<%= identifier %>-target="ruleCard" class="group relative border border-gray-200 p-4 rounded-lg bg-gray-50 hover:border-gray-300 space-y-4">
  
  <%# 1. Button to remove individual rule (cross) %>
  <button type="button" 
          data-action="click-><%= identifier %>#removeRule" 
          class="absolute top-3 right-3 text-gray-400 hover:text-red-500 font-bold p-1 transition-colors">
    ✕
  </button>

  <%# 2. Select for choosing the rule type for THIS specific card %>
  <div>
    <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">
      <%= t('recurrence_ui.labels.frequency', default: 'Frequency') %>
    </label>

    <select data-item="ruleType" 
            data-action="change-><%= identifier %>#toggleCardFields" 
            class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
      <%# Render options based on resolved enabled rule types %>
      <% rule_options.each do |label, value| %>
        <option value="<%= value %>"><%= label %></option>
      <% end %>
    </select>
  </div>

  <%# 3. Flat field blocks inside the card (Specific Fields) %>
    <%# Iterate through the resolved rule options %>
    <% rule_options.map(&:last).each do |rule| %>
    <div data-item="specificFields" data-rule="<%= rule %>" class="hidden">
        <%= render "recurrence_ui/#{rule}", form: form, identifier: identifier, days_for_ui: days_for_ui, rec_ui: rec_ui %>
    </div>
    <% end %>

  <%# 4. Individual Termination Section for THIS specific rule card %>
  <div data-item="terminationBlock" class="pt-4 border-t border-gray-100">
    <%= render "recurrence_ui/termination", form: form, identifier: identifier, rec_ui: rec_ui %>
  </div>
</div>