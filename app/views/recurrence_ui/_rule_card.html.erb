<%# app/views/recurrence_ui/_rule_card.html.erb %>
<div data-<%= identifier %>-target="ruleCard" class="group relative py-1.5">
  
  <%# 1. Шапка правила: Текст оформлен как ссылка с прерывистым подчёркиванием, напротив — крестик %>
  <div class="flex items-center justify-between gap-4 py-1 cursor-pointer select-none">
    
    <%# Текстовое описание правила в виде интерактивной ссылки %>
    <div class="flex-1 min-w-0" data-action="click-><%= identifier %>#toggleCardAccordion">
      <span data-item="cardSummary" 
            class="text-sm font-medium text-blue-600 hover:text-blue-800 underline underline-offset-4 decoration-dashed decoration-blue-400 hover:decoration-blue-600 transition-colors cursor-pointer">
        <%= t('recurrence_ui.labels.new_rule', default: 'Новое правило') %>
      </span>
    </div>

    <%# Крестик для удаления правила напротив %>
    <button type="button" 
            data-action="click-><%= identifier %>#removeRule" 
            title="<%= t('recurrence_ui.actions.remove', default: 'Удалить') %>"
            class="text-slate-400 hover:text-red-600 font-bold px-1.5 py-0.5 text-xs transition-colors rounded hover:bg-slate-100">
      ✕
    </button>
  </div>

  <%# 2. Раскрывающийся блок настроек правила (по умолчанию hidden) %>
  <div data-<%= identifier %>-target="cardBody" class="hidden mt-2 pt-3 pb-3 pl-3 pr-2 space-y-3 border-l-2 border-blue-200 bg-slate-50/50 rounded-r-md">
    
    <%# Выбор частоты %>
    <div>
      <label class="block text-xs font-medium text-slate-600 mb-1">
        <%= t('recurrence_ui.labels.frequency', default: 'Частота') %>
      </label>

      <select data-item="ruleType" 
              data-action="change-><%= identifier %>#toggleCardFields" 
              class="block w-full text-sm rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
        <% rule_options.each do |label, value| %>
          <option value="<%= value %>"><%= label %></option>
        <% end %>
      </select>
    </div>

    <%# Specific Fields for Each Rule %>
    <% rule_options.map(&:last).each do |rule| %>
      <div data-item="specificFields" data-rule="<%= rule %>" class="hidden">
        <%= render "recurrence_ui/#{rule}", form: form, identifier: identifier, days_for_ui: days_for_ui, rec_ui: rec_ui %>
      </div>
    <% end %>

    <%# Termination Block %>
    <div data-item="terminationBlock" class="pt-2 border-t border-slate-200">
      <%= render "recurrence_ui/termination", form: form, identifier: identifier, rec_ui: rec_ui %>
    </div>

    <%# Button Done %>
    <div class="pt-1 text-right">
      <button type="button" 
              data-action="click-><%= identifier %>#toggleCardAccordion" 
              class="px-2.5 py-1 text-xs font-medium text-slate-700 bg-white border border-slate-300 hover:bg-slate-100 rounded shadow-sm">
        <%= t('recurrence_ui.actions.done', default: 'Done') %>
      </button>
    </div>

  </div>
</div>