<%# app/views/recurrence_ui/_rule_card.html.erb %>
<div data-<%= identifier %>-target="ruleCard" class="group relative py-0.5">
  
  <%# Шапка правила: Крестик СНАЧАЛА, затем текст-ссылка %>
  <div class="flex items-center gap-2 py-0.5 cursor-pointer select-none">
    
    <%# 1. Крестик в начале строки %>
    <button type="button" 
            data-action="click-><%= identifier %>#removeRule" 
            title="<%= t('recurrence_ui.actions.remove', default: 'Удалить') %>"
            class="text-slate-400 hover:text-red-600 font-normal text-xs px-1 hover:bg-slate-100 rounded transition-colors">
      ✕
    </button>

    <%# 2. Текст правила (ссылка) %>
    <div class="flex-1 min-w-0" data-action="click-><%= identifier %>#toggleCardAccordion">
      <span data-item="cardSummary" 
            class="text-sm font-medium text-blue-600 hover:text-blue-800 underline underline-offset-4 decoration-dashed decoration-blue-400 hover:decoration-blue-600 transition-colors">
        <%= t('recurrence_ui.labels.new_rule', default: 'Новое правило') %>
      </span>
    </div>

  </div>

  <%# Тело аккордеона правила %>
  <div data-<%= identifier %>-target="cardBody" class="hidden mt-1 pt-2 pb-2 pl-3 space-y-2 border-l-2 border-blue-200 bg-slate-50/50 rounded-r-md">
    <div>
      <label class="block text-xs font-medium text-slate-600 mb-1">
        <%= t('recurrence_ui.labels.frequency', default: 'Частота') %>
      </label>

      <select data-item="ruleType" 
              data-action="change-><%= identifier %>#toggleCardFields" 
              class="block w-full text-xs rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
        <% rule_options.each do |label, value| %>
          <option value="<%= value %>"><%= label %></option>
        <% end %>
      </select>
    </div>

    <% rule_options.map(&:last).each do |rule| %>
      <div data-item="specificFields" data-rule="<%= rule %>" class="hidden">
        <%= render "recurrence_ui/#{rule}", form: form, identifier: identifier, days_for_ui: days_for_ui, rec_ui: rec_ui %>
      </div>
    <% end %>

    <div data-item="terminationBlock" class="pt-2 border-t border-slate-200">
      <%= render "recurrence_ui/termination", form: form, identifier: identifier, rec_ui: rec_ui %>
    </div>

    <div class="pt-0.5 text-right">
      <button type="button" 
              data-action="click-><%= identifier %>#toggleCardAccordion" 
              class="px-2 py-0.5 text-xs font-medium text-slate-700 bg-white border border-slate-300 hover:bg-slate-100 rounded shadow-sm">
        <%= t('recurrence_ui.actions.done', default: 'Готово') %>
      </button>
    </div>

  </div>
</div>