<%# app/views/recurrence_ui/_rule_card.html.erb %>
<div data-<%= identifier %>-target="ruleCard" class="group relative py-0.5 w-full">
  
  <%# 1. Rule Header: Summary Accordion Link & Delete action %>
  <div class="flex items-center gap-2 py-0.5 select-none">
    
    <%# Remove Rule Button (Крестик удаления) %>
    <button type="button" 
            data-action="click-><%= identifier %>#removeRule" 
            title="<%= t('recurrence_ui.actions.remove', default: 'Delete') %>"
            class="rui-btn-remove flex-shrink-0">
      ✕
    </button>

    <%# Rule Summary Link (Toggle Accordion) %>
    <div class="flex-1 min-w-0 cursor-pointer" data-action="click-><%= identifier %>#toggleCardAccordion">
      <span data-item="cardSummary" class="rui-accordion-link truncate block">
        <%= t('recurrence_ui.labels.new_rule', default: 'New rule') %>
      </span>
    </div>

  </div>

  <%# 2. Rule Accordion Body %>
  <div data-<%= identifier %>-target="cardBody" class="hidden rui-card-body">
    
    <%# Frequency Selector Block %>
    <div>
      <label class="rui-label">
        <%= t('recurrence_ui.labels.frequency', default: 'Frequency') %>
      </label>
      <select data-item="ruleType" 
              data-action="change-><%= identifier %>#toggleCardFields" 
              class="rui-select w-full">
        <% rule_options.each do |label, value| %>
          <option value="<%= value %>"><%= label %></option>
        <% end %>
      </select>
    </div>

    <%# Dynamic Specific Rule Fields %>
    <% rule_options.map(&:last).each do |rule| %>
      <div data-item="specificFields" data-rule="<%= rule %>" class="hidden">
        <%= render "recurrence_ui/#{rule}", form: form, identifier: identifier, days_for_ui: days_for_ui, rec_ui: rec_ui %>
      </div>
    <% end %>


    <%# Termination Settings Section %>
    <div data-item="terminationBlock" class="rui-divider pt-2">
      <%= render "recurrence_ui/termination", form: form, identifier: identifier, rec_ui: rec_ui %>
    </div>

    <%# Accordion Close Action %>
    <div class="pt-1 text-right">
      <button type="button" 
              data-action="click-><%= identifier %>#toggleCardAccordion" 
              class="rui-btn-secondary">
        <%= t('recurrence_ui.actions.done', default: 'Done') %>
      </button>
    </div>

  </div>
</div>