<%# app/views/recurrence_ui/_start_at.html.erb %>
<% default_start_time = rec_ui.start_time || RecurrenceUi.config.resolved_start_time %>
<div class="rui-grid-2" style="gap: 0.75rem;">
  
  <!-- 1. Дата и время начала (всегда на одной строке, не тянутся) -->
  <div>
    <%= form.label :start_at, t('recurrence_ui.labels.start_at'), class: "rui-label" %>
    <div class="rui-start-at-row">
      <%= form.date_field :form_start_date, 
          value: form.object.start_time_in_zone(:event)&.to_date || Date.current,                  
          class: "rui-input-date",
          data: { "#{identifier}_target": "startDate", 
          action: "change->#{identifier}#calculateEndDateFromDuration" } %>
      <%= form.time_field :form_start_time, 
              value: form.object.start_time_in_zone(:event)&.strftime('%H:%M') || default_start_time, 
              class: "rui-input-time",
              data: { "#{identifier}_target": "startTime", 
              action: "change->#{identifier}#calculateEndDateFromDuration" } 
      %>
    </div>  
  </div>
</div>