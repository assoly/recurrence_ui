<%# app/views/recurrence_ui/_summary_link.html.erb %>

<div data-<%= identifier %>-target="displayMode" class="group cursor-pointer">
  <div class="flex items-center gap-3">
    <%# Текст саммари с прерывистой линией %>
    <span 
      data-<%= identifier %>-target="summaryText" 
      data-action="click-><%= identifier %>#editRule"
      class="text-gray-700 font-medium border-b-2 border-dotted border-blue-400 hover:border-blue-600 hover:text-blue-600 transition-colors duration-200"
    >
      <%= t("recurrence_ui.one_time", default: "Does not repeat") %>    
    </span>

    <%# Иконка карандаша появляется только при наведении на весь блок %>
    <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-200">
      <%= heroicon_tag "pencil-square", 
          variant: :outline, 
          class: "w-4 h-4 text-gray-400" %>
    </div>
  </div>
</div>