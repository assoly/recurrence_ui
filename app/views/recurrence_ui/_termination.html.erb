<%# app/views/recurrence_ui/_termination.html.erb %>

<div class="border-t border-gray-100 pt-4">
  <label class="block text-sm font-semibold text-gray-700 mb-3">
    <%= t("recurrence_ui.labels.termination", default: "Ends") %>
  </label>
  
  <div class="flex flex-wrap items-center gap-3">
    <%= select_tag :end_type, 
        options_for_select([
          [t("recurrence_ui.termination_types.never", default: "Never"), 'never'], 
          [t("recurrence_ui.termination_types.until", default: "On date"), 'until'], 
          [t("recurrence_ui.termination_types.count", default: "After number of times"), 'count']
        ]), 
        class: "text-sm rounded-md border-gray-300", 
        data: { "#{identifier}_target": "endType", action: "change->#{identifier}#toggleEndFields" } 
    %>
    
    <input type="date" 
           class="hidden text-sm rounded-md border-gray-300" 
           data-<%= identifier %>-target="endDate" 
           data-action="change-><%= identifier %>#updateHiddenHash">
    
    <div data-<%= identifier %>-target="endCount" class="hidden items-center gap-2">
      <input type="number" min="1" placeholder="10" 
             class="w-20 text-sm rounded-md border-gray-300" 
             data-<%= identifier %>-target="endCountInput" 
             data-action="input-><%= identifier %>#updateHiddenHash">
      <span class="text-xs text-gray-500 uppercase font-bold">
        <%= t("recurrence_ui.labels.times", default: "times") %>
      </span>
    </div>
  </div>
</div>