<div class="rui-divider pt-3">
  <label class="rui-label mb-2">
    <%= t("recurrence_ui.labels.termination") %>
  </label>
  
  <div class="flex flex-wrap items-center gap-2">
    <%# Termination Type Selector %>
    <%= select_tag :end_type, 
        options_for_select([
          [t("recurrence_ui.termination_types.never"), 'never'], 
          [t("recurrence_ui.termination_types.until"), 'until'], 
          [t("recurrence_ui.termination_types.count"), 'count']
        ]), 
        class: "rui-select", 
        data: { 
          item: "endType", 
          action: "change->#{identifier}#toggleEndFields" 
        } 
    %>
    
    <%# Specific Date Input %>
    <input type="date" 
           class="rui-input hidden text-xs" 
           data-item="endDateInput" 
           data-action="change-><%= identifier %>#onCardInputChanged">
    
    <%# Count Input Field %>
    <div data-item="endCount" class="hidden flex items-center gap-2">
      <input type="number" min="1" placeholder="10" 
             class="rui-input w-20 text-xs" 
             data-item="endCountInput" 
             data-action="input-><%= identifier %>#onCardInputChanged">
      <span class="text-xs text-gray-500 dark:text-gray-400 uppercase font-semibold">
        <%= t("recurrence_ui.labels.times") %>
      </span>
    </div>
  </div>
</div>