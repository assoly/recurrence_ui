<%# Time zone %>
<div class="rui-timezone-container">
  <%= form.label :time_zone, t('recurrence_ui.labels.time_zone'), class: "rui-label" %>
  <%= form.time_zone_select :time_zone, 
        ActiveSupport::TimeZone.all, 
        { default: rec_ui.record.public_send(rec_ui.time_zone_field).presence || Time.zone.name }, 
        { class: "rui-input rui-select rui-timezone-select" } 
  %>
</div>