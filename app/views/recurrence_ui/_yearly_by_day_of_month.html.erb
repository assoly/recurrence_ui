<%# app/views/recurrence_ui/_yearly_by_day_of_month.html.erb %>
<%# Yearly Recurrence Rule Options (By Day of Month) %>
<% selected_days_for_yearly = local_assigns.fetch(:selected_days_for_yearly, {}) %>

<div class="space-y-3" data-item="specificFields" data-rule="yearly_by_day_of_month">
  <%# Interval Input Header %>
  <div class="flex items-center space-x-2">
    <span class="rui-inline-label">
      <%= t("recurrence_ui.labels.every", default: "Every") %>
    </span>

    <%= number_field_tag nil, rec_ui.initial_interval, 
          min: 1, 
          class: "rui-input w-16 text-center",
          data: { 
            item: "interval", 
            action: "input->#{identifier}#onCardInputChanged" 
          } %>

    <span class="rui-inline-label">
      <%= t("recurrence_ui.labels.year", count: rec_ui.initial_interval, default: "year(s)") %>
    </span>
  </div>

  <%# Month Selector %>
  <div data-<%= identifier %>-target="monthSelector" class="flex items-center gap-3">
    <label class="rui-inline-label whitespace-nowrap">
      <%= t("recurrence_ui.labels.choose_month", default: "Choose month") %>:
    </label>

    <select data-<%= identifier %>-target="monthInput" 
            data-item="month" 
            data-action="change-><%= identifier %>#onCardInputChanged" 
            class="rui-select w-full sm:w-auto">
      <% (1..12).each do |m| %>
        <% month_name = I18n.t("recurrence_ui.date.standalone_month_names", default: I18n.t("recurrence_ui.date.month_names"))[m] %>
        <option value="<%= m %>"><%= month_name %></option>
      <% end %>
    </select>
  </div>

  <%# Month Days Selection Section %>
  <div data-<%= identifier %>-target="monthlyDays">
    <label class="rui-label mb-2">
      <%= t("recurrence_ui.labels.select_dates", default: "Select dates") %>:
    </label>
    
    <div class="grid grid-cols-7 gap-1">
      <% (1..31).each do |day| %>
        <% is_selected = selected_days_for_yearly.to_a.include?(day) %> 
        <button type="button" 
                class="rui-day-btn"
                data-day="<%= day %>"
                data-<%= identifier %>-target="dayButton"
                data-selected="<%= is_selected %>"
                data-action="click-><%= identifier %>#toggleDay">
          <%= day %>
        </button>
      <% end %>
    </div>
  </div>
</div>