<!-- app/views/dev/recurrence_previews/index.html.erb -->

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Recurrence UI Parity Preview</title>
  
  <%# Включаем теги импорта JS и CSS вашего движка/приложения %>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <%# Подключаем стили и JS (укажите ваши asset-хелперы) %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
</head>
<body class="bg-gray-50 p-8">
<div class="p-8 max-w-7xl mx-auto space-y-12">
  <h1 class="text-3xl font-bold">Recurrence Summary: Ruby vs JS Parity Matrix</h1>

  <% @locales.each do |locale| %>
    <section class="border border-gray-300 rounded-lg p-6 bg-white shadow-sm space-y-4">
      <h2 class="text-2xl font-bold text-indigo-600 border-b pb-2">
        Locale: <%= locale.to_s.upcase %>
      </h2>

      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-100 text-xs font-semibold text-gray-600 uppercase">
            <th class="p-3">Rule Case</th>
            <th class="p-3">Ruby (Server) Output</th>
            <th class="p-3">JS (Client) Output</th>
            <th class="p-3 text-center">Parity</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 text-sm">
          <% @rule_cases.each do |test_case| %>
            <% 
              json_payload = test_case[:hash].to_json 
              # Вызываем именно ваш сервис:
              ruby_summary = RecurrenceUi::RecurrenceSummaryService.new(test_case[:hash], locale).to_s
            %>
            <tr class="hover:bg-gray-50" data-parity-row>
              <!-- 1. Название и JSON -->
              <td class="p-3 align-top font-medium">
                <div><%= test_case[:name] %></div>
                <code class="text-xs text-gray-400 block mt-1"><%= json_payload %></code>
              </td>

              <!-- 2. Результат Ruby -->
              <td class="p-3 align-top bg-blue-50/30" data-ruby-output>
                <%= ruby_summary %>
              </td>

              <!-- 3. Результат JS (Stimulus рендерит прямо при загрузке) -->
              <td class="p-3 align-top bg-green-50/30">
                <div data-controller="recurrence-ui"
                     data-recurrence-ui-translations-value="<%= I18n.t('recurrence_ui', locale: locale).to_json %>"
                     data-recurrence-ui-locale-value="<%= locale %>">
                  
                  <input type="hidden" 
                         data-recurrence-ui-target="hiddenField" 
                         value="<%= json_payload %>">
                  <input type="hidden" 
                         data-recurrence-ui-target="ruleType" 
                         value="<%= test_case[:hash][:rule_type].demodulize.underscore.gsub('_rule', '') %>">

                  <div data-recurrence-ui-target="summaryText" data-js-output>
                    <!-- Сюда Stimulus вставит свой текст -->
                  </div>
                </div>
              </td>

              <!-- 4. Статус совпадения (автоматически проверяется скриптом) -->
              <td class="p-3 align-top text-center" data-status-cell>
                <span class="inline-flex items-center px-2 py-1 rounded text-xs font-bold bg-gray-100 text-gray-500">
                  Checking...
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
</div>

<!-- Маленький скрипт для сравнения текстов и подсветки расхождений -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    setTimeout(() => { // Небольшой таймаут, чтобы Stimulus успел отрендерить summaryText
      document.querySelectorAll('[data-parity-row]').forEach(row => {
        const rubyText = row.querySelector('[data-ruby-output]').innerText.replace(/\s+/g, ' ').trim();
        const jsText = row.querySelector('[data-js-output]').innerText.replace(/\s+/g, ' ').trim();
        const statusCell = row.querySelector('[data-status-cell]');

        if (rubyText === jsText) {
          statusCell.innerHTML = `<span class="px-2 py-1 rounded text-xs font-bold bg-green-100 text-green-800">MATCH ✓</span>`;
        } else {
          statusCell.innerHTML = `<span class="px-2 py-1 rounded text-xs font-bold bg-red-100 text-red-800">MISMATCH ✗</span>`;
          row.classList.add('bg-red-50');
        }
      });
    }, 300);
  });
</script>
</body>
</html>