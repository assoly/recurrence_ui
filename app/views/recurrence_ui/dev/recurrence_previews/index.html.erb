<!-- app/views/recurrence_ui/dev/recurrence_previews/index.html.erb -->
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Recurrence UI Parity Preview</title>
  
  <%# Include CSRF and CSP tags %>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <%# Include application styles and javascript %>
<%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
<%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
</head>
<body class="bg-gray-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 antialiased p-8 transition-colors">
<!-- Floating Theme Toggle Button for Testing -->
<button type="button" 
        onclick="document.documentElement.classList.toggle('dark')" 
        class="fixed top-4 right-4 z-50 px-3 py-2 text-xs font-semibold rounded-lg bg-gray-200 dark:bg-gray-800 text-gray-800 dark:text-gray-200 border border-gray-300 dark:border-gray-700 shadow-md hover:opacity-80 transition-all cursor-pointer flex items-center gap-2">
  <span>🌙 / ☀️</span>
  <span>Toggle Theme</span>
</button>
<div class="max-w-7xl mx-auto space-y-12">

  <!-- TOP HEADER & LOCALE SWITCHER -->
  <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-6 border-b border-slate-200 gap-4">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Recurrence UI Debug & Parity Dashboard</h1>
      <p class="text-sm text-slate-500 mt-1">Development environment for testing multi-rule schedules, locale fallback, and JS/Ruby output parity.</p>
    </div>
        <div>
        <!-- Переключатель темы -->
      <button type="button" 
              onclick="document.documentElement.classList.toggle('dark')" 
              class="px-3 py-1.5 text-xs font-medium rounded-md bg-gray-200 dark:bg-gray-800 text-gray-800 dark:text-gray-200 border border-gray-300 dark:border-gray-700 transition-colors">
        🌙 / ☀️ Switch Dark/Light Mode
      </button>
        </div>
    <!-- Locale Switcher for Supported Locales -->
    <div class="flex items-center space-x-2 bg-white p-2 rounded-lg border border-slate-200 shadow-sm">
      <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider px-2">Locale:</span>
      <div class="flex space-x-1">
        <% @locales.each do |loc| %>
          <% is_active = (params[:locale].presence || @context_sources[:resolved][:locale]).to_s == loc.to_s %>
          <%= link_to loc.to_s.upcase, 
                      url_for(locale: loc, time_zone: params[:time_zone], week_start: params[:week_start]), 
                      class: "px-3 py-1.5 text-xs font-bold rounded-md transition-colors #{is_active ? 'bg-indigo-600 text-white shadow-sm' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}" %>
        <% end %>
      </div>
    </div>
  </header>

  <!-- SECTION 1: GEM DESCRIPTION -->
  <section class="p-6 bg-white rounded-xl border border-slate-200 shadow-sm font-sans space-y-3">
    <div class="flex items-center space-x-2">
      <div class="p-2 bg-indigo-100 text-indigo-700 rounded-lg">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <h2 class="text-xl font-bold text-slate-800">1. Gem Overview</h2>
    </div>
    <p class="text-sm text-slate-600 leading-relaxed">
      <strong>Recurrence UI</strong> provides a clean, responsive ViewComponent and Stimulus controller for managing complex recurring schedules backed by <code>IceCube</code>. It supports multiple rules (<code>rrules</code>), exception dates (<code>exdates</code>), and additional dates (<code>rdates</code>) with seamless i18n translation parity between server-rendered Ruby summaries and client-side JavaScript UI.
    </p>
  </section>

<!-- SECTION 2: FORM TESTING -->
  <section class="p-6 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm font-sans space-y-6 transition-colors">
    <div class="border-b border-slate-100 dark:border-slate-800 pb-4 flex justify-between items-center">
      <div>
        <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">2. Interactive Form & Picker Component Testing</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">Component rendered directly via <code>RecurrenceUi::PickerComponent.new(record: @event)</code></p>
      </div>
      <span class="px-2.5 py-1 text-xs font-semibold bg-emerald-100 dark:bg-emerald-950 dark:text-emerald-300 text-emerald-800 rounded-full">Active Record Form Integration</span>
    </div>

    <% component = RecurrenceUi::PickerComponent.new(record: @event) %>

    <!-- Recurrence Summary Banner -->
    <div class="p-4 bg-indigo-50/60 dark:bg-indigo-950/40 rounded-lg border border-indigo-100 dark:border-indigo-900/50">
      <strong class="block text-xs font-semibold text-indigo-900 dark:text-indigo-300 uppercase tracking-wider mb-1">
        Current Recurrence Summary (Resolved Locale: <%= component.locale %>):
      </strong>
      <span class="text-sm font-medium text-indigo-950 dark:text-indigo-200">
        <%= component.recurrence_summary.presence || "No rules configured" %>
      </span>
    </div>

    <!-- Event Card & UI Picker Component -->
    <div id="<%= dom_id(@event) %>" class="w-full space-y-5 p-5 border border-slate-200 dark:border-slate-800 rounded-lg bg-slate-50/50 dark:bg-slate-950/50">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <strong class="block text-xs text-slate-500 dark:text-slate-400 mb-1">Title:</strong>
          <div class="text-sm font-semibold text-slate-800 dark:text-slate-200"><%= @event.title %></div>
        </div>
        
        <div>
          <strong class="block text-xs text-slate-500 dark:text-slate-400 mb-1">Description:</strong>
          <div class="text-sm text-slate-700 dark:text-slate-300"><%= @event.description %></div>
        </div>
      </div>

      <div>
        <strong class="block text-xs text-slate-500 dark:text-slate-400 mb-1">Recurring Rules Payload (Raw JSON Hash):</strong>
        <code class="block p-3 bg-slate-900 text-emerald-400 rounded-lg text-xs font-mono overflow-x-auto">
          <%= @event.recurring_rules.to_json %>
        </code>
      </div>

      <div>
        <strong class="block text-xs text-slate-500 dark:text-slate-400 mb-2">Rendered Picker Component:</strong>
        
        <!-- Обертка компонента с тёмным фоном -->
        <div class="bg-white dark:bg-slate-900 p-5 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm">
          <%= render component %>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: CONFIGURATION PRECEDENCE -->
  <section class="p-6 bg-slate-50 rounded-xl border border-slate-200 font-sans space-y-4">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-2">
      <div>
        <h2 class="text-xl font-bold text-slate-800">3. Configuration Precedence & Resolution</h2>
        <p class="text-xs text-slate-500">Priority increases downwards (URL and Session override Gem and Rails application defaults)</p>
      </div>
      <div class="text-xs bg-white px-3 py-1.5 rounded border border-slate-300 shadow-sm self-start md:self-auto">
        App Time: <strong class="text-indigo-600"><%= @current_time.strftime("%Y-%m-%d %H:%M:%S (%Z)") %></strong>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs border-collapse bg-white rounded-lg shadow-sm">
        <thead>
          <tr class="bg-slate-100 text-slate-600 border-b border-slate-200 uppercase font-semibold">
            <th class="p-3">Level / Layer Name</th>
            <th class="p-3">File / Source Location</th>
            <th class="p-3">Locale</th>
            <th class="p-3">Time Zone</th>
            <th class="p-3">First Day of Week</th>
            <th class="p-3">Note</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @context_sources.each do |key, source| %>
            <% is_resolved = key == :resolved %>
            <tr class="<%= is_resolved ? 'bg-indigo-50/90 font-bold text-indigo-950 border-t-2 border-indigo-200' : 'text-slate-700 hover:bg-slate-50/50' %>">
              <td class="p-3 font-semibold">
                <%= source[:title] %>
              </td>
              <td class="p-3 font-mono text-[11px] text-slate-500">
                <%= source[:file] %>
              </td>
              <td class="p-3">
                <%= source[:locale].present? ? content_tag(:span, source[:locale], class: "px-2 py-0.5 rounded bg-slate-100 text-slate-800 font-mono") : content_tag(:span, "— (nil)", class: "text-slate-300 italic") %>
              </td>
              <td class="p-3">
                <%= source[:time_zone].present? ? content_tag(:span, source[:time_zone], class: "px-2 py-0.5 rounded bg-slate-100 text-slate-800 font-mono") : content_tag(:span, "— (nil)", class: "text-slate-300 italic") %>
              </td>
              <td class="p-3">
                <%= source[:week_start].present? ? content_tag(:span, source[:week_start], class: "px-2 py-0.5 rounded bg-slate-100 text-slate-800 font-mono") : content_tag(:span, "— (nil)", class: "text-slate-300 italic") %>
              </td>
              <td class="p-3 text-slate-500 italic text-[11px]">
                <%= source[:note] %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Quick URL Parameter Testing Links -->
    <div class="pt-2 flex flex-wrap items-center gap-2 text-xs">
      <span class="text-slate-500 font-medium">Quick URL Test Presets:</span>
      <%= link_to "Tokyo / Japanese (Mon)", url_for(time_zone: "Asia/Tokyo", locale: "ja", week_start: 1), class: "px-2.5 py-1 bg-white border border-slate-300 rounded hover:bg-slate-50 text-indigo-600 font-medium shadow-sm" %>
      <%= link_to "New York / English (Sun)", url_for(time_zone: "America/New_York", locale: "en", week_start: 0), class: "px-2.5 py-1 bg-white border border-slate-300 rounded hover:bg-slate-50 text-indigo-600 font-medium shadow-sm" %>
      <%= link_to "Moscow / Russian (Mon)", url_for(time_zone: "Europe/Moscow", locale: "ru", week_start: 1), class: "px-2.5 py-1 bg-white border border-slate-300 rounded hover:bg-slate-50 text-indigo-600 font-medium shadow-sm" %>
      <%= link_to "Reset URL Parameters", url_for(locale: nil, time_zone: nil, week_start: nil), class: "px-2.5 py-1 bg-red-50 border border-red-200 rounded text-red-600 hover:bg-red-100 font-medium" %>
    </div>
  </section>

  <!-- SECTION 4: PARITY TESTING -->
  <section class="space-y-6">
    <div class="border-b border-slate-200 pb-4">
      <h2 class="text-2xl font-bold text-slate-900">4. Ruby vs JS Parity Matrix</h2>
      <p class="text-sm text-slate-500">Verification that <code>RecurrenceSummaryService</code> (Ruby) and Stimulus Controller (JS) produce identical text representations across all rule structures.</p>
    </div>

    <% @locales.each do |locale| %>
      <div class="border border-slate-300 rounded-xl p-6 bg-white shadow-sm space-y-4">
        <h3 class="text-xl font-bold text-indigo-600 border-b border-slate-100 pb-2 flex items-center justify-between">
          <span>Locale: <%= locale.to_s.upcase %></span>
          <span class="text-xs font-normal text-slate-400">Comparing <%= @rule_cases.size %> rule test cases</span>
        </h3>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-slate-100 text-xs font-semibold text-slate-600 uppercase tracking-wider">
                <th class="p-3">Rule Test Case</th>
                <th class="p-3">Ruby (Server) Output</th>
                <th class="p-3">JS (Client) Output</th>
                <th class="p-3 text-center">Parity Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 text-sm">
              <% @rule_cases.each do |test_case| %>
                <% 
                  json_payload = test_case[:hash].to_json 
                  options = { locale: locale }
                  ruby_summary = RecurrenceUi::RecurrenceSummaryService.new(test_case[:hash], options).to_s
                  first_rule = test_case[:hash][:rrules]&.first || test_case[:hash]
                  rule_type_name = first_rule[:rule_type].to_s.demodulize.underscore.gsub('_rule', '')
                %>
                <tr class="hover:bg-slate-50 transition-colors" data-parity-row>
                  <!-- 1. Case Name & JSON Payload -->
                  <td class="p-3 align-top font-medium max-w-xs">
                    <div class="text-slate-800 font-semibold"><%= test_case[:name] %></div>
                    <code class="text-[11px] text-slate-500 block mt-1 font-mono break-all bg-slate-100 p-1.5 rounded"><%= json_payload %></code>
                  </td>

                  <!-- 2. Ruby Output -->
                  <td class="p-3 align-top bg-blue-50/30 text-slate-800 font-medium" data-ruby-output>
                    <%= ruby_summary %>
                  </td>

                  <!-- 3. JS Output (Rendered via Stimulus) -->
                  <td class="p-3 align-top bg-emerald-50/30 text-slate-800 font-medium">
                    <div data-controller="recurrence-ui"
                         data-recurrence-ui-translations-value="<%= I18n.t('recurrence_ui', locale: locale).to_json %>"
                         data-recurrence-ui-locale-value="<%= locale %>">
                      
                      <input type="hidden" 
                             data-recurrence-ui-target="hiddenField" 
                             value="<%= json_payload %>">
                      <input type="hidden" 
                             data-recurrence-ui-target="ruleType" 
                             value="<%= rule_type_name %>">

                      <div data-recurrence-ui-target="summaryText" data-js-output>
                        <!-- Stimulus inserts summary text dynamically -->
                      </div>
                    </div>
                  </td>

                  <!-- 4. Parity Verification Badge -->
                  <td class="p-3 align-top text-center" data-status-cell>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-slate-100 text-slate-500 animate-pulse">
                      Checking...
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </section>

</div>

<!-- JavaScript for comparing output strings and highlighting mismatches -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    setTimeout(() => { // Small delay to allow Stimulus controllers to finish initial state evaluation
      document.querySelectorAll('[data-parity-row]').forEach(row => {
        const rubyCell = row.querySelector('[data-ruby-output]');
        const jsCell = row.querySelector('[data-js-output]');
        const statusCell = row.querySelector('[data-status-cell]');

        if (!rubyCell || !jsCell || !statusCell) return;

        const rubyText = rubyCell.innerText.replace(/\s+/g, ' ').trim();
        const jsText = jsCell.innerText.replace(/\s+/g, ' ').trim();

        if (rubyText === jsText) {
          statusCell.innerHTML = `<span class="px-2.5 py-1 rounded-md text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">MATCH ✓</span>`;
        } else {
          statusCell.innerHTML = `<span class="px-2.5 py-1 rounded-md text-xs font-bold bg-rose-100 text-rose-800 border border-rose-200">MISMATCH ✗</span>`;
          row.classList.add('bg-rose-50/60');
        }
      });
    }, 300);
  });
</script>
</body>
</html>