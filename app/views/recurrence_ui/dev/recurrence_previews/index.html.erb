<!-- app/views/dev/recurrence_previews/index.html.erb -->

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Recurrence UI Parity Preview</title>
  
  <%# Включаем теги импорта JS и CSS вашего движка/приложения %>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <%# Подключаем стили и JS (укажите ваши asset-хелперы) %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
</head>
<body class="bg-gray-50 p-8">
<div class="p-8 max-w-7xl mx-auto space-y-12">
<div class="mb-8 p-6 bg-slate-50 rounded-xl border border-slate-200 font-sans">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-bold text-slate-800"> Context Debugger (Источники параметров)</h2>
    <div class="text-sm bg-white px-3 py-1 rounded border border-slate-300">
      Текущее время: <strong class="text-indigo-600"><%= @current_time.strftime("%Y-%m-%d %H:%M:%S (%Z z)") %></strong>
    </div>
  </div>

  <!-- Таблица сравнения -->
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm border-collapse bg-white rounded-lg shadow-sm">
      <thead>
        <tr class="bg-slate-100 text-slate-600 border-b border-slate-200">
          <th class="p-3">Источник</th>
          <th class="p-3">Locale (`locale`)</th>
          <th class="p-3">Time Zone (`time_zone`)</th>
          <th class="p-3">First Day of Week (`week_start`)</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @context_sources.each do |key, source| %>
          <% is_resolved = key == :resolved %>
          <tr class="<%= is_resolved ? 'bg-indigo-50/70 font-semibold text-indigo-950' : 'text-slate-700' %>">
            <td class="p-3">
              <%= source[:title] %>
            </td>
            <td class="p-3">
              <%= source[:locale].present? ? source[:locale] : content_tag(:span, "— (nil)", class: "text-slate-400 italic") %>
            </td>
            <td class="p-3">
              <%= source[:time_zone].present? ? source[:time_zone] : content_tag(:span, "— (nil)", class: "text-slate-400 italic") %>
            </td>
            <td class="p-3">
              <%= source[:week_start].present? ? source[:week_start] : content_tag(:span, "— (nil)", class: "text-slate-400 italic") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Быстрые ссылки для тестирования переключения через URL -->
  <div class="mt-4 flex flex-wrap gap-2 text-xs">
    <span class="text-slate-500 self-center">Быстрые тесты URL:</span>
    <%= link_to "Токио / Японский (Mon)", url_for(time_zone: "Asia/Tokyo", locale: "ja", week_start: 1), class: "px-2 py-1 bg-white border border-slate-300 rounded hover:bg-slate-50 text-indigo-600" %>
    <%= link_to "Нью-Йорк / Английский (Sun)", url_for(time_zone: "America/New_York", locale: "en", week_start: 0), class: "px-2 py-1 bg-white border border-slate-300 rounded hover:bg-slate-50 text-indigo-600" %>
    <%= link_to "Москва / Русский (Mon)", url_for(time_zone: "Europe/Moscow", locale: "ru", week_start: 1), class: "px-2 py-1 bg-white border border-slate-300 rounded hover:bg-slate-50 text-indigo-600" %>
    <%= link_to "Сбросить URL параметры", url_for(locale: nil, time_zone: nil, week_start: nil), class: "px-2 py-1 bg-red-50 border border-red-200 rounded text-red-600 hover:bg-red-100" %>
  </div>
</div>
  <h1 class="text-3xl font-bold">Recurrence Summary: Ruby vs JS Parity Matrix</h1>

  <% @locales.each do |locale| %>
    <section class="border border-gray-300 rounded-lg p-6 bg-white shadow-sm space-y-4">
      <h2 class="text-2xl font-bold text-indigo-600 border-b pb-2">
        Locale: <%= locale.to_s.upcase %>
      </h2>

      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-100 text-xs font-semibold text-gray-600 uppercase">
            <th class="p-3">Rule Case</th>
            <th class="p-3">Ruby (Server) Output</th>
            <th class="p-3">JS (Client) Output</th>
            <th class="p-3 text-center">Parity</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 text-sm">
          <% @rule_cases.each do |test_case| %>
            <% 
              json_payload = test_case[:hash].to_json 
              options = {}
              options[:locale] = locale
              # Вызываем именно ваш сервис:
              ruby_summary = RecurrenceUi::RecurrenceSummaryService.new(test_case[:hash], options).to_s
            %>
            <tr class="hover:bg-gray-50" data-parity-row>
              <!-- 1. Название и JSON -->
              <td class="p-3 align-top font-medium">
                <div><%= test_case[:name] %></div>
                <code class="text-xs text-gray-400 block mt-1"><%= json_payload %></code>
              </td>

              <!-- 2. Результат Ruby -->
              <td class="p-3 align-top bg-blue-50/30" data-ruby-output>
                <%= ruby_summary %>
              </td>

              <!-- 3. Результат JS (Stimulus рендерит прямо при загрузке) -->
              <td class="p-3 align-top bg-green-50/30">
                <div data-controller="recurrence-ui"
                     data-recurrence-ui-translations-value="<%= I18n.t('recurrence_ui', locale: locale).to_json %>"
                     data-recurrence-ui-locale-value="<%= locale %>">
                  
                  <input type="hidden" 
                         data-recurrence-ui-target="hiddenField" 
                         value="<%= json_payload %>">
                  <input type="hidden" 
                         data-recurrence-ui-target="ruleType" 
                         value="<%= test_case[:hash][:rule_type].demodulize.underscore.gsub('_rule', '') %>">

                  <div data-recurrence-ui-target="summaryText" data-js-output>
                    <!-- Сюда Stimulus вставит свой текст -->
                  </div>
                </div>
              </td>

              <!-- 4. Статус совпадения (автоматически проверяется скриптом) -->
              <td class="p-3 align-top text-center" data-status-cell>
                <span class="inline-flex items-center px-2 py-1 rounded text-xs font-bold bg-gray-100 text-gray-500">
                  Checking...
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
</div>

<!-- Маленький скрипт для сравнения текстов и подсветки расхождений -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    setTimeout(() => { // Небольшой таймаут, чтобы Stimulus успел отрендерить summaryText
      document.querySelectorAll('[data-parity-row]').forEach(row => {
        const rubyText = row.querySelector('[data-ruby-output]').innerText.replace(/\s+/g, ' ').trim();
        const jsText = row.querySelector('[data-js-output]').innerText.replace(/\s+/g, ' ').trim();
        const statusCell = row.querySelector('[data-status-cell]');

        if (rubyText === jsText) {
          statusCell.innerHTML = `<span class="px-2 py-1 rounded text-xs font-bold bg-green-100 text-green-800">MATCH ✓</span>`;
        } else {
          statusCell.innerHTML = `<span class="px-2 py-1 rounded text-xs font-bold bg-red-100 text-red-800">MISMATCH ✗</span>`;
          row.classList.add('bg-red-50');
        }
      });
    }, 300);
  });
</script>
</body>
</html>